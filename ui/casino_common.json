{
  "namespace": "casino_ui",

  //// Briques communes aux ecrans du casino //////////////////////////////////////////
  //
  // "collection_index" sur un controle isole est ignore par le jeu (tout retombe sur le slot 0).
  // On passe donc par une vraie grille 9x6 (le jeu numerote lui-meme les cases 0-53),
  // placee dans une fenetre "clips_children" qui ne laisse voir qu'une seule case.
  //
  // Decalage de la grille pour montrer le slot N (colonne = N % 9, ligne = N / 9) :
  //   $grid_offset = [ -colonne * largeur_case, -ligne * hauteur_case ]

  //// Texte d'un slot ///////////////////////////////////////////////////////////////
  // Affiche le nom de l'item du slot, sans survol. Item : nom court, SANS lore.
  // Usage (slot 46, case de 84 px) :
  //   { "bet@casino_ui.slot_text": { "$grid_offset": [ -84, -50 ] } }
  // Texte aligne a droite : ajoute "$cell_template": "casino_ui.slot_text_cell_right"

  // Les variables ne traversent pas les templates de grille : valeurs ecrites en dur.
  "slot_text_cell": {
    "type": "label",
    "text": "#hover_text",
    "shadow": true,
    "font_scale_factor": 0.55,
    "text_alignment": "left",
    "size": [ 84, 10 ],
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "container_items"
      }
    ]
  },

  "slot_text_cell_right@casino_ui.slot_text_cell": {
    "text_alignment": "right"
  },

  "slot_text": {
    "type": "panel",
    "$cell_template|default": "casino_ui.slot_text_cell",
    "size": [ 84, 10 ],
    "clips_children": true,
    "layer": 6,
    "controls": [
      {
        "grid": {
          "type": "grid",
          "size": [ 756, 60 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": "$grid_offset",
          "grid_dimensions": [ 9, 6 ],
          "collection_name": "container_items",
          "grid_item_template": "$cell_template"
        }
      }
    ]
  },

  //// Slot cliquable ////////////////////////////////////////////////////////////////
  // Usage (slot 49 = colonne 4, ligne 5) :
  //   { "cashout@casino_ui.slot": { "$grid_offset": [ -72, -90 ] } }

  "slot_cell@common.container_item": {
    "$item_collection_name": "container_items",
    "$background_images": "mines_ui.mines_cell_bg"
  },

  "slot": {
    "type": "panel",
    "size": [ 18, 18 ],
    "clips_children": true,
    "layer": 4,
    "controls": [
      {
        "grid": {
          "type": "grid",
          "size": [ 162, 108 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": "$grid_offset",
          "grid_dimensions": [ 9, 6 ],
          "collection_name": "container_items",
          "grid_item_template": "casino_ui.slot_cell"
        }
      }
    ]
  },

  //// Animations ////////////////////////////////////////////////////////////////////

  // Halo qui respire (boucle)
  "pulse_in": { "anim_type": "alpha", "easing": "in_out_sine", "duration": 0.8, "from": 0.15, "to": 0.6, "next": "@casino_ui.pulse_out" },
  "pulse_out": { "anim_type": "alpha", "easing": "in_out_sine", "duration": 0.8, "from": 0.6, "to": 0.15, "next": "@casino_ui.pulse_in" },

  "pulse_glow": {
    "type": "image",
    "texture": "$glow_texture",
    "$glow_texture|default": "textures/ui/green",
    "alpha": 0.15,
    "anims": [ "@casino_ui.pulse_in" ],
    "layer": 3
  }
}

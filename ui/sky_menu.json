{
  //// Thème sombre des menus InvMenu / VirtualInventory (concept B) : en-tête 18 px + bande d'accent,
  //// corps sombre, pied plus foncé pour l'inventaire. Couleurs dans chest_screen.json / redstone_screen.json.
  //// IMPORTANT : chaque image a "keep_ratio": false, sinon Bedrock garde le ratio 1:1 de la texture
  //// (c'est ce qui donnait le petit carré à la place de la bande).

  "namespace": "sky_menu",
  "small_chest_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {
          "control_name": "@chest.selected_item_details"
        }
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "control_name": "@common.item_lock_notification"
        }
      },
      {
        "root_panel@common.root_panel": {
          "size": [
            176,
            174
          ],
          "layer": 1,
          "controls": [
            {
              "outline": {
                "type": "image",
                "texture": "textures/sky_ui/white",
                "keep_ratio": false,
                "color": [
                  0,
                  0,
                  0
                ],
                "size": [
                  178,
                  176
                ],
                "layer": 1,
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [
                  0,
                  0
                ]
              }
            },
            {
              "bg": {
                "type": "image",
                "texture": "textures/sky_ui/white",
                "keep_ratio": false,
                "color": "$sky_bg",
                "size": [
                  176,
                  174
                ],
                "layer": 2,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  0,
                  0
                ]
              }
            },
            {
              "header_bg": {
                "type": "image",
                "texture": "textures/sky_ui/white",
                "keep_ratio": false,
                "color": "$sky_header",
                "size": [
                  176,
                  18
                ],
                "layer": 3,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  0,
                  0
                ]
              }
            },
            {
              "accent": {
                "type": "image",
                "texture": "textures/sky_ui/white",
                "keep_ratio": false,
                "color": "$sky_accent",
                "size": [
                  176,
                  2
                ],
                "layer": 4,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  0,
                  16
                ]
              }
            },
            {
              "footer_bg": {
                "type": "image",
                "texture": "textures/sky_ui/white",
                "keep_ratio": false,
                "color": "$sky_footer",
                "size": [
                  176,
                  93
                ],
                "layer": 3,
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "offset": [
                  0,
                  0
                ]
              }
            },
            {
              "footer_line": {
                "type": "image",
                "texture": "textures/sky_ui/white",
                "keep_ratio": false,
                "color": [
                  0.04,
                  0.04,
                  0.05
                ],
                "size": [
                  176,
                  1
                ],
                "layer": 4,
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "offset": [
                  0,
                  -92
                ]
              }
            },
            {
              "title": {
                "type": "label",
                "layer": 5,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  7,
                  5
                ],
                "size": [
                  150,
                  10
                ],
                "text": "$container_title",
                "color": [
                  1,
                  1,
                  1
                ],
                "shadow": true,
                "localize": "$localize_title",
                "enable_profanity_filter": true
              }
            },
            {
              "close@common.close_button": {
                "layer": 6,
                "size": [
                  14,
                  14
                ],
                "$close_button_offset": [
                  -2,
                  2
                ],
                "$close_button_panel_size": [
                  12,
                  12
                ]
              }
            },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "grid@chest.small_chest_grid": {
                      "offset": [
                        7,
                        22
                      ]
                    }
                  },
                  {
                    "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                  },
                  {
                    "hotbar_grid@common.hotbar_grid_template": {}
                  },
                  {
                    "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                  },
                  {
                    "flying_item_renderer@common.flying_item_renderer": {
                      "layer": 15
                    }
                  }
                ]
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            }
          ]
        }
      }
    ]
  },

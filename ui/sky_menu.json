{
  "namespace": "sky_menu",

  //// Thème sombre commun à tous les menus InvMenu / VirtualInventory (coffre, double coffre, hopper).
  //// La couleur de la bande d'en-tête vient de $sky_accent, choisie dans chest_screen.json / redstone_screen.json
  //// selon un mot-clé invisible au début du titre (codes couleur §).

  "fill": {
    "type": "image",
    "texture": "textures/sky_ui/white",
    "$fill_color|default": [ 0.11, 0.11, 0.125 ],
    "color": "$fill_color"
  },

  "header": {
    "type": "panel",
    "size": [ "100%", 18 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "$sky_accent|default": [ 0.55, 0.55, 0.58 ],
    "controls": [
      { "bg@sky_menu.fill": { "size": [ "100%", "100%" ], "layer": 1, "$fill_color": [ 0.15, 0.15, 0.17 ] } },
      {
        "accent@sky_menu.fill": {
          "size": [ "100%", 2 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "layer": 2,
          "$fill_color": "$sky_accent"
        }
      },
      {
        "title": {
          "type": "label",
          "layer": 3,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 7, -1 ],
          "size": [ "100% - 30px", "default" ],
          "text": "$container_title",
          "color": [ 0.95, 0.95, 0.95 ],
          "shadow": true,
          "localize": "$localize_title",
          "enable_profanity_filter": true
        }
      },
      {
        "close@common.close_button": {
          "layer": 4,
          "$close_button_offset": [ -1, 1 ],
          "size": [ 16, 16 ],
          "$close_button_panel_size": [ 12, 12 ]
        }
      }
    ]
  },

  "inventory_footer": {
    "type": "panel",
    "size": [ "100%", 93 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "controls": [
      { "bg@sky_menu.fill": { "size": [ "100%", "100%" ], "layer": 1, "$fill_color": [ 0.08, 0.08, 0.09 ] } },
      { "line@sky_menu.fill": { "size": [ "100%", 1 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 2, "$fill_color": [ 0.2, 0.2, 0.23 ] } },
      { "inventory@common.inventory_panel_bottom_half_with_label": { "size": [ "100%", "100%" ], "layer": 3 } },
      { "hotbar@common.hotbar_grid_template": { "layer": 3 } }
    ]
  },

  //// Écran complet : $sky_grid = grille du conteneur, $sky_size = taille totale, $sky_grid_offset = position de la grille.
  "panel": {
    "type": "panel",
    "$sky_size|default": [ 176, 230 ],
    "$sky_grid_offset|default": [ 7, 22 ],
    "$sky_show_inventory|default": true,
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "selected_item_details_factory@common.selected_item_details_factory": { "control_name": "@chest.selected_item_details" } },
      { "item_lock_notification_factory@common.item_lock_notification_factory": { "control_name": "@common.item_lock_notification" } },
      {
        "root_panel@common.root_panel": {
          "size": "$sky_size",
          "layer": 1,
          "controls": [
            { "outline@sky_menu.fill": { "size": [ "100% + 2px", "100% + 2px" ], "layer": 1, "$fill_color": [ 0.0, 0.0, 0.0 ] } },
            { "bg@sky_menu.fill": { "size": [ "100%", "100%" ], "layer": 2 } },
            {
              "content": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  { "header@sky_menu.header": {} },
                  {
                    "grid@$sky_grid": {
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": "$sky_grid_offset"
                    }
                  },
                  { "footer@sky_menu.inventory_footer": {} },
                  { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} },
                  { "flying_item_renderer@common.flying_item_renderer": { "layer": 15 } }
                ]
              }
            },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  },

  "large_panel@sky_menu.panel": {
    "$sky_grid": "chest.large_chest_grid",
    "$sky_size": [ 176, 230 ],
    "$sky_grid_offset": [ 7, 23 ]
  },

  "small_panel@sky_menu.panel": {
    "$sky_grid": "chest.small_chest_grid",
    "$sky_size": [ 176, 176 ],
    "$sky_grid_offset": [ 7, 23 ]
  },

  "hopper_grid": {
    "type": "grid",
    "size": [ 90, 18 ],
    "grid_dimensions": [ 5, 1 ],
    "collection_name": "container_items",
    "grid_item_template": "common.container_item",
    "$item_collection_name": "container_items"
  },

  "hopper_panel@sky_menu.panel": {
    "$sky_grid": "sky_menu.hopper_grid",
    "$sky_size": [ 176, 140 ],
    "$sky_grid_offset": [ 43, 25 ]
  }
}

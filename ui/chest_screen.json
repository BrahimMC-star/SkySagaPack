        "$sky_accent": [
          0.64,
          0.36,
          0.94
        ]
      },
      {
        "requires": "(not (($container_title_copy - $kw_sky_red) = $container_title_copy))",
        "$sky_accent": [
          0.88,
          0.33,
          0.33
        ]
      }
    ],
    "$kw_sky_gold": "§6§2§r",
    "$kw_sky_green": "§2§6§r",
    "$kw_sky_blue": "§9§3§r",
    "$kw_sky_purple": "§5§d§r",
    "$kw_sky_red": "§4§c§r"
  },

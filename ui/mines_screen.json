{
  "namespace": "mines_ui",

  "mines_cell_bg": {
    "type": "image",
    "texture": "textures/ui/button_borderless_dark",
    "size": [ 18, 18 ],
    "layer": 1
  },

  "mines_grid_item@common.container_item": {
    "$item_collection_name": "container_items",
    "$background_images": "mines_ui.mines_cell_bg"
  },

  "mines_grid": {
    "type": "grid",
    "size": [ 162, 108 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [ 9, 6 ],
    "grid_item_template": "mines_ui.mines_grid_item",
    "collection_name": "container_items",
    "layer": 4
  },

  "mines_legend_item": {
    "type": "label",
    "text": "$legend_text",
    "color": "$legend_color",
    "shadow": true,
    "font_scale_factor": 0.8,
    "layer": 4
  },

  "mines_legend": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", 10 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 19 ],
    "layer": 4,
    "controls": [
      { "froid@mines_ui.mines_legend_item": { "$legend_text": "Froid  ", "$legend_color": [ 0.29, 0.48, 1.0 ] } },
      { "tiede@mines_ui.mines_legend_item": { "$legend_text": "Tiede  ", "$legend_color": [ 0.35, 0.87, 0.42 ] } },
      { "chaud@mines_ui.mines_legend_item": { "$legend_text": "Chaud  ", "$legend_color": [ 1.0, 0.85, 0.29 ] } },
      { "brulant@mines_ui.mines_legend_item": { "$legend_text": "Brulant", "$legend_color": [ 1.0, 0.54, 0.16 ] } }
    ]
  },

  "mines_title": {
    "type": "label",
    "text": "Mines",
    "color": [ 1.0, 0.85, 0.29 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 7 ],
    "shadow": true,
    "layer": 4
  },

  "mines_root": {
    "type": "panel",
    "size": [ 190, 150 ],
    "layer": 1,
    "controls": [
      { "bg": { "type": "image", "texture": "textures/ui/dark_bg", "size": [ "100%", "100%" ], "layer": 1 } },
      { "frame": { "type": "image", "texture": "textures/ui/button_borderless_dark", "size": [ "100%", "100%" ], "layer": 2 } },
      {
        "cashout_bar": {
          "type": "image",
          "texture": "textures/ui/button_borderless_light",
          "color": [ 0.25, 0.7, 0.35 ],
          "size": [ 54, 18 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 68, 122 ],
          "layer": 2
        }
      },
      { "mines_title@mines_ui.mines_title": {} },
      { "mines_legend@mines_ui.mines_legend": {} },
      { "mines_grid@mines_ui.mines_grid": { "offset": [ 14, 32 ] } }
    ]
  },

  "mines_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {
          "control_name": "@chest.selected_item_details"
        }
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "control_name": "@common.item_lock_notification"
        }
      },
      {
        "root_panel@common.root_panel": {
          "size": [ 190, 150 ],
          "layer": 1,
          "controls": [
            { "mines_root@mines_ui.mines_root": {} },
            { "flying_item_renderer@common.flying_item_renderer": { "layer": 15 } },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  }
}

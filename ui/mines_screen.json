{
  "namespace": "mines_ui",

  "mines_cell_bg": {
    "type": "image",
    "texture": "textures/ui/button_borderless_dark",
    "size": [ 18, 18 ],
    "layer": 1
  },

  "mines_grid_item@common.container_item": {
    "$item_collection_name": "container_items",
    "$background_images": "mines_ui.mines_cell_bg"
  },

  "mines_grid": {
    "type": "grid",
    "size": [ 162, 108 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [ 9, 6 ],
    "grid_item_template": "mines_ui.mines_grid_item",
    "collection_name": "container_items",
    "layer": 4
  },

  //// Legende du bas : glyph (icone) + mot en texte normal ///////////////////////

  "legend_glyph": {
    "type": "label",
    "text": "$glyph",
    "color": [ 1.0, 1.0, 1.0 ],
    "font_scale_factor": 0.6,
    "layer": 4
  },

  "legend_word": {
    "type": "label",
    "text": "$word",
    "color": "$word_color",
    "shadow": true,
    "font_scale_factor": 0.8,
    "layer": 4
  },

  "legend_entry": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", 12 ],
    "layer": 4,
    "controls": [
      { "icon@mines_ui.legend_glyph": {} },
      { "gap": { "type": "panel", "size": [ 2, 1 ] } },
      { "word@mines_ui.legend_word": {} },
      { "space": { "type": "panel", "size": [ 6, 1 ] } }
    ]
  },

  "mines_legend": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", 12 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ 0, -5 ],
    "layer": 4,
    "controls": [
      { "cold@mines_ui.legend_entry": { "$glyph": "", "$word": "Froid", "$word_color": [ 0.35, 0.55, 1.0 ] } },
      { "warm@mines_ui.legend_entry": { "$glyph": "", "$word": "Tiede", "$word_color": [ 0.35, 0.87, 0.42 ] } },
      { "hot@mines_ui.legend_entry": { "$glyph": "", "$word": "Chaud", "$word_color": [ 1.0, 0.85, 0.29 ] } },
      { "burning@mines_ui.legend_entry": { "$glyph": "", "$word": "Brulant", "$word_color": [ 1.0, 0.54, 0.16 ] } }
    ]
  },

  "setup_hint": {
    "type": "label",
    "text": "Choisis ta mise et le nombre de mines",
    "color": [ 0.6, 0.6, 0.7 ],
    "shadow": true,
    "font_scale_factor": 0.8,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ 0, -6 ],
    "layer": 4
  },

  //// Titres ///////////////////////////////////////////////////////////////////////

  "screen_title": {
    "type": "label",
    "text": "$screen_title_text",
    "color": [ 1.0, 0.85, 0.29 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 6 ],
    "shadow": true,
    "layer": 4
  },

  "bar": {
    "type": "image",
    "texture": "$bar_texture",
    "alpha": "$bar_alpha",
    "size": [ 54, 18 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": "$bar_offset",
    "layer": 3
  },

  "frame_bg": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "o_a": { "type": "image", "texture": "textures/ui/Black", "size": [ "100% - 4px", "100%" ], "anchor_from": "center", "anchor_to": "center", "layer": 1 } },
      { "o_b": { "type": "image", "texture": "textures/ui/Black", "size": [ "100% - 2px", "100% - 2px" ], "anchor_from": "center", "anchor_to": "center", "layer": 1 } },
      { "o_c": { "type": "image", "texture": "textures/ui/Black", "size": [ "100%", "100% - 4px" ], "anchor_from": "center", "anchor_to": "center", "layer": 1 } },
      { "i_a": { "type": "image", "texture": "textures/ui/dark_bg", "size": [ "100% - 8px", "100% - 4px" ], "anchor_from": "center", "anchor_to": "center", "layer": 2 } },
      { "i_b": { "type": "image", "texture": "textures/ui/dark_bg", "size": [ "100% - 6px", "100% - 6px" ], "anchor_from": "center", "anchor_to": "center", "layer": 2 } },
      { "i_c": { "type": "image", "texture": "textures/ui/dark_bg", "size": [ "100% - 4px", "100% - 8px" ], "anchor_from": "center", "anchor_to": "center", "layer": 2 } }
    ]
  },

  //// Ecran de jeu (titre "mines_ui") ///////////////////////////////////////////////

  "mines_root": {
    "type": "panel",
    "size": [ 210, 152 ],
    "layer": 1,
    "controls": [
      { "bg@mines_ui.frame_bg": {} },
      { "cashout_bar@mines_ui.bar": { "$bar_texture": "textures/ui/green", "$bar_alpha": 0.4, "$bar_offset": [ 78, 109 ] } },
      { "title@mines_ui.screen_title": { "$screen_title_text": "Mines" } },
      { "grid@mines_ui.mines_grid": { "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [ 0, 19 ] } },
      { "legend@mines_ui.mines_legend": {} }
    ]
  },

  //// Ecran de mise (titre "mines_setup") //////////////////////////////////////////

  "setup_root": {
    "type": "panel",
    "size": [ 210, 152 ],
    "layer": 1,
    "controls": [
      { "bg@mines_ui.frame_bg": {} },
      { "cancel_bar@mines_ui.bar": { "$bar_texture": "textures/ui/button_red", "$bar_alpha": 0.55, "$bar_offset": [ 24, 109 ] } },
      { "start_bar@mines_ui.bar": { "$bar_texture": "textures/ui/green", "$bar_alpha": 0.4, "$bar_offset": [ 78, 109 ] } },
      { "title@mines_ui.screen_title": { "$screen_title_text": "Nouvelle partie" } },
      { "grid@mines_ui.mines_grid": { "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [ 0, 19 ] } },
      { "hint@mines_ui.setup_hint": {} }
    ]
  },

  //// Panneaux d'ecran (sans inventaire du joueur) ///////////////////////////////////

  "mines_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {
          "control_name": "@chest.selected_item_details"
        }
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "control_name": "@common.item_lock_notification"
        }
      },
      {
        "root_panel@common.root_panel": {
          "size": [ 210, 152 ],
          "layer": 1,
          "controls": [
            { "mines_root@mines_ui.mines_root": {} },
            { "flying_item_renderer@common.flying_item_renderer": { "layer": 15 } },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  },

  "setup_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {
          "control_name": "@chest.selected_item_details"
        }
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "control_name": "@common.item_lock_notification"
        }
      },
      {
        "root_panel@common.root_panel": {
          "size": [ 210, 152 ],
          "layer": 1,
          "controls": [
            { "setup_root@mines_ui.setup_root": {} },
            { "flying_item_renderer@common.flying_item_renderer": { "layer": 15 } },
            { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
            { "gamepad_cursor@common.gamepad_cursor_button": {} }
          ]
        }
      }
    ]
  }
}

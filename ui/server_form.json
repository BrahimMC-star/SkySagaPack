{
  "namespace": "server_form",

  //// SkySaga : formulaires personnalises reconnus par un mot-cle dans leur titre ////////////////
  // Methode du Bedrock Wiki (json-ui/modifying-server-forms) : on AJOUTE une deuxieme factory qui
  // recoit les memes donnees que le formulaire vanilla, et on cache le vanilla quand le mot-cle est
  // present. Les formulaires sans mot-cle restent 100 % vanilla.
  //
  // Mots-cles :
  //   isl_select  -> choix d'ile (IslandSelector.php). Boutons par index :
  //                  0-2 categories | 3 Precedent | 4 Choisir | 5 Fermer | 6 Suivant | 7 ligne d'info

  "main_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "skysaga_server_form_factory": {
              "type": "panel",
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.skysaga_long_form"
                }
              }
            }
          }
        ]
      }
    ]
  },

  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'isl_select') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "skysaga_long_form": {
    "type": "panel",
    "size": [ 360, 210 ],
    "controls": [
      { "island_select@server_form.isl_root": {} }
    ]
  },

  //// Choix d'ile (titre "isl_select<nom>") ///////////////////////////////////////////////////////
  // Le centre reste vide et transparent : c'est la que la camera tourne autour de l'ile.

  "isl_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'isl_select') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "header@server_form.isl_header": {} },
      { "categories@server_form.isl_categories": {} },
      { "description@server_form.isl_description": {} },
      { "navigation@server_form.isl_navigation": {} }
    ]
  },

  // En haut : nom de l'ile (titre sans le mot-cle) + ligne d'info (bouton 7, affiche comme un texte).
  "isl_header": {
    "type": "panel",
    "size": [ 200, 40 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "collection_name": "form_buttons",
    "controls": [
      { "bg@mines_ui.frame_bg": {} },
      {
        "name": {
          "type": "label",
          "text": "#text",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 6 ],
          "font_scale_factor": 1.35,
          "shadow": true,
          "layer": 4,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'isl_select')",
              "target_property_name": "#text"
            }
          ]
        }
      },
      {
        "info": {
          "type": "label",
          "text": "#form_button_text",
          "collection_index": 7,
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -5 ],
          "font_scale_factor": 0.85,
          "shadow": true,
          "layer": 4,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // A gauche : les 3 categories, empilees.
  "isl_categories": {
    "type": "panel",
    "size": [ 92, 74 ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ 0, -6 ],
    "collection_name": "form_buttons",
    "controls": [
      { "overworld@server_form.isl_button": { "collection_index": 0, "$isl_btn_size": [ 92, 22 ], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 0, 0 ] } },
      { "nether@server_form.isl_button": { "collection_index": 1, "$isl_btn_size": [ 92, 22 ], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 0, 26 ] } },
      { "end@server_form.isl_button": { "collection_index": 2, "$isl_btn_size": [ 92, 22 ], "anchor_from": "top_left", "anchor_to": "top_left", "offset": [ 0, 52 ] } }
    ]
  },

  // A droite : la description (contenu du formulaire).
  "isl_description": {
    "type": "panel",
    "size": [ 112, 108 ],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [ 0, -6 ],
    "controls": [
      { "bg@mines_ui.frame_bg": {} },
      {
        "text": {
          "type": "label",
          "text": "#form_text",
          "size": [ "100% - 14px", "default" ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 7, 7 ],
          "font_scale_factor": 0.85,
          "shadow": true,
          "layer": 4
        }
      }
    ]
  },

  // En bas : Choisir au-dessus de Fermer, Precedent a gauche, Suivant a droite.
  "isl_navigation": {
    "type": "panel",
    "size": [ 342, 48 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "collection_name": "form_buttons",
    "controls": [
      { "previous@server_form.isl_button": { "collection_index": 3, "$isl_btn_size": [ 110, 22 ], "anchor_from": "bottom_left", "anchor_to": "bottom_left", "offset": [ 0, 0 ] } },
      { "choose@server_form.isl_button": { "collection_index": 4, "$isl_btn_size": [ 110, 22 ], "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [ 0, 0 ] } },
      { "close@server_form.isl_button": { "collection_index": 5, "$isl_btn_size": [ 110, 22 ], "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "offset": [ 0, 0 ] } },
      { "next@server_form.isl_button": { "collection_index": 6, "$isl_btn_size": [ 110, 22 ], "anchor_from": "bottom_right", "anchor_to": "bottom_right", "offset": [ 0, 0 ] } }
    ]
  },

  //// Bouton sombre (style Mines) branche sur un bouton du formulaire par collection_index ////////

  "isl_button": {
    "type": "panel",
    "$isl_btn_size|default": [ 92, 22 ],
    "size": "$isl_btn_size",
    "controls": [
      {
        "button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": [ "100%", "100%" ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ],
          "controls": [
            { "default@server_form.isl_button_face": { "$isl_face": "textures/ui/button_borderless_dark" } },
            { "hover@server_form.isl_button_face": { "$isl_face": "textures/ui/button_borderless_darkhover" } },
            { "pressed@server_form.isl_button_face": { "$isl_face": "textures/ui/button_borderless_darkpressed" } }
          ]
        }
      }
    ]
  },

  "isl_button_face": {
    "type": "image",
    "texture": "$isl_face",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "#form_button_text",
          "shadow": true,
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}

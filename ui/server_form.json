{
  "namespace": "server_form",

  //// SkySaga : formulaires personnalises reconnus par un mot-cle dans leur titre ////////////////
  // Methode du Bedrock Wiki (json-ui/modifying-server-forms) : on AJOUTE une deuxieme factory qui
  // recoit les memes donnees que le formulaire vanilla, et on cache le vanilla quand le mot-cle est
  // present. Les formulaires sans mot-cle restent 100 % vanilla.
  //
  // Mots-cles :
  //   isl_select  -> choix d'ile (IslandSelector.php). Boutons par index :
  //                  0-2 categories | 3 Precedent | 4 Choisir | 5 Fermer | 6 Suivant | 7 ligne d'info

  "main_screen_content": {
    // Pleine taille (vanilla : [0, 0]) pour que l'ecran custom puisse s'etaler jusqu'aux bords.
    // Les formulaires vanilla ont une taille fixe et restent centres : rien ne change pour eux.
    "size": [ "100%", "100%" ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "skysaga_server_form_factory": {
              "type": "panel",
              "size": [ "100%", "100%" ],
              "factory": {
                "name": "server_form_factory",
                "control_ids": {
                  "long_form": "@server_form.skysaga_long_form"
                }
              }
            }
          }
        ]
      }
    ]
  },

  "long_form": {
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          { "binding_name": "#title_text" },
          {
            "binding_type": "view",
            "source_property_name": "((#title_text - 'isl_select') = #title_text)",
            "target_property_name": "#visible"
          }
        ]
      }
    ]
  },

  "skysaga_long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "island_select@server_form.isl_root": {} }
    ]
  },

  //// Choix d'ile (titre "isl_select<nom>") ///////////////////////////////////////////////////////
  // Le centre reste vide et transparent : c'est la que la camera tourne autour de l'ile.
  // Les boutons sont lus par collection_index : leur parent DOIT etre un stack_panel
  // (un "panel" ne gere pas les collections, tous les boutons liraient alors le n°0).

  "isl_root": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "bindings": [
      { "binding_name": "#title_text" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'isl_select') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "header@server_form.isl_header": {} },
      { "categories@server_form.isl_categories": {} },
      { "description@server_form.isl_description": {} },
      { "bottom@server_form.isl_bottom": {} }
    ]
  },

  // En haut : nom de l'ile (titre sans le mot-cle) + ligne d'info (bouton 7, affiche comme un texte).
  "isl_header": {
    "type": "panel",
    "size": [ 200, 40 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, "6%" ],
    "controls": [
      { "bg@mines_ui.frame_bg": {} },
      {
        "name": {
          "type": "label",
          "text": "#text",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 6 ],
          "font_scale_factor": 1.35,
          "shadow": true,
          "layer": 4,
          "bindings": [
            { "binding_name": "#title_text" },
            {
              "binding_type": "view",
              "source_property_name": "(#title_text - 'isl_select')",
              "target_property_name": "#text"
            }
          ]
        }
      },
      {
        "info_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", 10 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -5 ],
          "collection_name": "form_buttons",
          "layer": 4,
          "controls": [
            {
              "info": {
                "type": "label",
                "text": "#form_button_text",
                "collection_index": 7,
                "size": [ "default", 10 ],
                "font_scale_factor": 0.85,
                "shadow": true,
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // A gauche : les 3 categories, empilees (chaque bouton fait 22 de haut + 4 d'espace).
  "isl_categories": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 92, "100%c" ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ "12%", -10 ],
    "collection_name": "form_buttons",
    "controls": [
      { "overworld@server_form.isl_button": { "collection_index": 0, "$isl_slot_size": [ 92, 26 ], "$isl_btn_size": [ 92, 22 ] } },
      { "nether@server_form.isl_button": { "collection_index": 1, "$isl_slot_size": [ 92, 26 ], "$isl_btn_size": [ 92, 22 ] } },
      { "end@server_form.isl_button": { "collection_index": 2, "$isl_slot_size": [ 92, 26 ], "$isl_btn_size": [ 92, 22 ] } }
    ]
  },

  // A droite : la description (contenu du formulaire).
  "isl_description": {
    "type": "panel",
    "size": [ 120, 108 ],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [ "-12%", -10 ],
    "controls": [
      { "bg@mines_ui.frame_bg": {} },
      {
        "text": {
          "type": "label",
          "text": "#form_text",
          "size": [ "100% - 14px", "default" ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 7, 7 ],
          "font_scale_factor": 0.85,
          "shadow": true,
          "layer": 4
        }
      }
    ]
  },

  // En bas : Choisir (centre) au-dessus de la ligne Precedent / Fermer / Suivant.
  "isl_bottom": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 348, 52 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ 0, "-8%" ],
    "controls": [
      {
        "choose_line": {
          "type": "panel",
          "size": [ 348, 26 ],
          "controls": [ { "choose_row@server_form.isl_choose_row": {} } ]
        }
      },
      { "navigation@server_form.isl_navigation": {} }
    ]
  },

  "isl_choose_row": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", 26 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "collection_name": "form_buttons",
    "controls": [
      { "choose@server_form.isl_button": { "collection_index": 4, "$isl_slot_size": [ 116, 26 ], "$isl_btn_size": [ 110, 22 ] } }
    ]
  },

  "isl_navigation": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ 348, 26 ],
    "collection_name": "form_buttons",
    "controls": [
      { "previous@server_form.isl_button": { "collection_index": 3, "$isl_slot_size": [ 116, 26 ], "$isl_btn_size": [ 110, 22 ] } },
      { "close@server_form.isl_button": { "collection_index": 5, "$isl_slot_size": [ 116, 26 ], "$isl_btn_size": [ 110, 22 ] } },
      { "next@server_form.isl_button": { "collection_index": 6, "$isl_slot_size": [ 116, 26 ], "$isl_btn_size": [ 110, 22 ] } }
    ]
  },

  //// Bouton sombre (style Mines) branche sur un bouton du formulaire par collection_index ////////

  "isl_button": {
    "type": "panel",
    "$isl_slot_size|default": [ 92, 26 ],
    "$isl_btn_size|default": [ 92, 22 ],
    "size": "$isl_slot_size",
    "controls": [
      {
        "button@common.button": {
          "$pressed_button_name": "button.form_button_click",
          "size": "$isl_btn_size",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ],
          "controls": [
            { "default@server_form.isl_button_face": { "$isl_face": "textures/ui/button_borderless_dark" } },
            { "hover@server_form.isl_button_face": { "$isl_face": "textures/ui/button_borderless_darkhover" } },
            { "pressed@server_form.isl_button_face": { "$isl_face": "textures/ui/button_borderless_darkpressed" } }
          ]
        }
      }
    ]
  },

  "isl_button_face": {
    "type": "image",
    "texture": "$isl_face",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "#form_button_text",
          "shadow": true,
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}
